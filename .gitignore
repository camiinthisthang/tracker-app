# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# .next.prodbuild/ is a local-only copy of a production build (~hundreds of MB)
# that some local build/preview scripts emit. It is NOT needed in the repo and
# must never be committed — leave it ignored. Safe to delete anytime:
#   rm -rf .next.prodbuild
/.next.prodbuild/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# claude code (personal/local config)
.claude/settings.local.json

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
.env*.local
