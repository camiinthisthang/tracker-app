generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── MULTI-TENANCY ──────────────────────────────────────────

model Team {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members   TeamMember[]
  campaigns Campaign[]
  creators  Creator[]
  apiKeys   ApiKey[]
  settings  TeamSettings?
  invites   TeamInvite[]
  hooks     Hook[]
  bonusRules BonusRule[]

  @@map("teams")
}

model TeamSettings {
  id               String  @id @default(cuid())
  teamId           String  @unique
  team             Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  weeklyReportDay  Int     @default(1)
  weeklyReportTime String  @default("09:00")
  timezone         String  @default("America/New_York")

  tiktokApiKey     String?
  instagramToken   String?
  youtubeApiKey    String?
  facebookToken    String?

  // PostHog attribution (see src/app/api/cron/posthog-sync/route.ts).
  posthogApiKey    String?
  posthogProjectId String?
  posthogHost      String?

  // Scheduling link for interview invites (e.g., https://cal.com/yourname/interview)
  schedulingUrl    String?

  // Default pinned welcome message shown at the top of /creator-tasks for any
  // new creator. The token {{schedulingUrl}} is replaced with this team's
  // schedulingUrl when the message is created on creator approval.
  creatorWelcomeTemplate String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("team_settings")
}

// ─── USERS & AUTH ──────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  // Platform-level role: super admins (the agency operator, e.g. Cami) can manage
  // multiple client teams, invite managers into them, and read cross-team data.
  isSuperAdmin  Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts    Account[]
  sessions    Session[]
  memberships TeamMember[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── TEAM MEMBERSHIP ────────────────────────────────────────

enum Role {
  ADMIN
  MEMBER
  CREATOR
}

model TeamMember {
  id        String   @id @default(cuid())
  userId    String
  teamId    String
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  creatorId String?  @unique
  creator   Creator? @relation(fields: [creatorId], references: [id])

  @@unique([userId, teamId])
  @@map("team_members")
}

model TeamInvite {
  id         String   @id @default(cuid())
  teamId     String
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  email      String
  role       Role     @default(ADMIN)
  token      String   @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([teamId])
  @@map("team_invites")
}

// ─── CAMPAIGNS ──────────────────────────────────────────────

model Campaign {
  id               String    @id @default(cuid())
  teamId           String
  team             Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name             String
  imageUrl         String?
  startDate        DateTime
  endDate          DateTime
  isActive         Boolean   @default(true)
  hashtags         String[]
  weeklyPostTarget Int       @default(5)
  ugcEngineer      String?
  previewLinks     String[]
  galleryUrls      String[]
  lastSyncAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  campaignCreators  CampaignCreator[]
  posts             Post[]
  tasks             Task[]
  dailyMetrics      CampaignDailyMetric[]
  notificationRules NotificationRule[]
  weeklyReports     WeeklyReportConfig[]
  uploads           Upload[]
  creatorMessages   CreatorMessage[]

  @@index([teamId])
  @@map("campaigns")
}

// ─── CREATORS ───────────────────────────────────────────────

enum CreatorTier {
  TRAINING
  BRONZE
  SILVER
  GOLD
}

enum Platform {
  TIKTOK
  INSTAGRAM
  YOUTUBE
  FACEBOOK
}

model Creator {
  id        String      @id @default(cuid())
  teamId    String
  team      Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name      String
  handle    String
  tier      CreatorTier @default(TRAINING)
  isActive  Boolean     @default(true)
  email     String?
  avatarUrl String?

  // TikTok OAuth (Display API — identity only)
  tiktokUserId       String?
  tiktokUsername     String?
  tiktokAccessToken  String?
  tiktokRefreshToken String?
  tiktokTokenExpires DateTime?
  tiktokConnectedAt  DateTime?

  // Public handles used by the scraper-based sync (Apify). TikTok also falls
  // back to `handle` / `tiktokUsername` when tiktokHandle is empty.
  tiktokHandle    String?
  instagramHandle String?

  // Invite flow
  inviteToken String? @unique

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  // Notification preferences; shape:
  // { viralEmail: bool, viralSms: bool, phoneNumber?: string, threshold?: int }
  notificationPrefs Json?

  campaignCreators CampaignCreator[]
  posts            Post[]
  tasks            Task[]
  teamMember       TeamMember?
  earnings         CreatorEarning[]
  uploads          Upload[]
  messages         CreatorMessage[]
  attributions     CreatorAttribution[]
  viralNotifications ViralNotification[]

  @@index([teamId])
  @@map("creators")
}

model CampaignCreator {
  id           String   @id @default(cuid())
  campaignId   String
  creatorId    String
  platform     Platform @default(TIKTOK)
  videosPerDay Int      @default(1)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creator  Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([campaignId, creatorId])
  @@map("campaign_creators")
}

// ─── POSTS & METRICS ────────────────────────────────────────

model Post {
  id           String   @id @default(cuid())
  campaignId   String
  creatorId    String
  platform     Platform
  username     String
  title        String?
  externalId   String
  link         String
  thumbnailUrl String?
  postedAt     DateTime
  views        Int      @default(0)
  likes        Int      @default(0)
  shares       Int      @default(0)
  saves        Int      @default(0)
  comments     Int      @default(0)
  referrals    Int      @default(0)
  hook         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  campaign       Campaign              @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creator        Creator               @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  metricsHistory PostMetricsSnapshot[]
  contentTraits  ContentTraits?

  @@unique([platform, externalId])
  @@index([campaignId])
  @@index([creatorId])
  @@index([postedAt])
  @@map("posts")
}

model PostMetricsSnapshot {
  id       String   @id @default(cuid())
  postId   String
  post     Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  date     DateTime @db.Date
  views    Int      @default(0)
  likes    Int      @default(0)
  shares   Int      @default(0)
  saves    Int      @default(0)
  comments Int      @default(0)

  @@unique([postId, date])
  @@index([postId])
  @@map("post_metrics_snapshots")
}

model CampaignDailyMetric {
  id             String   @id @default(cuid())
  campaignId     String
  campaign       Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  date           DateTime @db.Date
  totalPosts     Int      @default(0)
  totalViews     Int      @default(0)
  totalLikes     Int      @default(0)
  totalShares    Int      @default(0)
  totalSaves     Int      @default(0)
  totalComments  Int      @default(0)
  activeCreators Int      @default(0)

  @@unique([campaignId, date])
  @@index([campaignId])
  @@map("campaign_daily_metrics")
}

// ─── BONUS RULES ───────────────────────────────────────────

enum BonusTrigger {
  VIEW_THRESHOLD
  VIRAL_COUNT
  REFERRAL_COUNT
  USER_DOWNLOAD
  USER_PAID_PLAN
}

model BonusRule {
  id        String       @id @default(cuid())
  teamId    String
  team      Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  trigger   BonusTrigger
  threshold Int
  amountUsd Decimal      @db.Decimal(10, 2)
  label     String
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([teamId, isActive])
  @@map("bonus_rules")
}

// ─── HOOKS (taxonomy) ───────────────────────────────────────

model Hook {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  text      String
  category  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  uploads Upload[]

  @@index([teamId, isActive])
  @@map("hooks")
}

// ─── CONTENT TRAITS (AI) ────────────────────────────────────

model ContentTraits {
  id         String   @id @default(cuid())
  postId     String   @unique
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  hook       String?
  formatType String?
  expression String?
  location   String?
  analyzedAt DateTime @default(now())

  @@map("content_traits")
}

// ─── TASKS ──────────────────────────────────────────────────

enum TaskType {
  REVIEW_FEEDBACK
  POST_VIDEOS
  UPLOAD_FOR_REVIEW
  RESPOND_TO_COMMENTS
  ONBOARDING
  CUSTOM
}

model Task {
  id          String    @id @default(cuid())
  // Onboarding tasks are created at creator approval and aren't tied to any
  // campaign, so campaignId is nullable.
  campaignId  String?
  creatorId   String
  type        TaskType
  title       String
  description String?
  dueDate     DateTime
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creator  Creator   @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId, dueDate])
  @@index([campaignId])
  @@map("tasks")
}

// ─── NOTIFICATIONS ──────────────────────────────────────────

enum NotificationRuleType {
  TOP_POSTS_WEEKLY
  TOP_POSTS_DAILY
  THRESHOLD_HIT
}

model NotificationRule {
  id              String               @id @default(cuid())
  campaignId      String
  campaign        Campaign             @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  type            NotificationRuleType
  name            String
  description     String?
  isEnabled       Boolean              @default(true)
  webhookUrl      String
  thresholdMetric String?
  thresholdValue  Int?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([campaignId])
  @@map("notification_rules")
}

// ─── CREATOR MESSAGES (from manager) ────────────────────────

enum CreatorMessageType {
  HOOK_SUGGESTION
  FEEDBACK
  ANNOUNCEMENT
  CAMPAIGN_UPDATE
}

model CreatorMessage {
  id         String             @id @default(cuid())
  creatorId  String
  campaignId String?
  type       CreatorMessageType @default(ANNOUNCEMENT)
  title      String
  body       String
  isRead     Boolean            @default(false)
  isPinned   Boolean            @default(false)
  createdAt  DateTime           @default(now())

  creator  Creator   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([creatorId, createdAt])
  @@map("creator_messages")
}

// ─── WEEKLY REPORTS ─────────────────────────────────────────

model WeeklyReportConfig {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  isEnabled  Boolean  @default(true)
  recipients String[]
  publicSlug String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([campaignId])
  @@map("weekly_report_configs")
}

// ─── UPLOADS ────────────────────────────────────────────────

enum UploadStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UploadCategory {
  CONTENT
  ONBOARDING_DOCS
}

model Upload {
  id          String       @id @default(cuid())
  // Null for onboarding-document uploads (tax forms, IDs) that aren't tied to
  // a specific campaign.
  campaignId  String?
  creatorId   String
  fileName    String
  fileUrl     String
  fileSize    Int
  category    UploadCategory @default(CONTENT)
  status      UploadStatus @default(PENDING)
  feedback    String?
  reviewedAt  DateTime?

  // Hook tagging — creators either pick a predefined Hook (`hookId`) or type a
  // one-off freestyle hook (`freestyleHook`). Exactly one is set in practice.
  hookId        String?
  hook          Hook?    @relation(fields: [hookId], references: [id], onDelete: SetNull)
  freestyleHook String?

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creator  Creator   @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([creatorId])
  @@map("uploads")
}

// ─── API KEYS ───────────────────────────────────────────────

model ApiKey {
  id         String    @id @default(cuid())
  teamId     String
  team       Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name       String
  keyHash    String    @unique
  keyPrefix  String
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([teamId])
  @@map("api_keys")
}

// ─── CREATOR APPLICATIONS ───────────────────────────────────

enum ApplicationStatus {
  PENDING
  REVIEWING
  APPROVED
  REJECTED
}

model CreatorApplication {
  id            String            @id @default(cuid())
  name          String
  email         String
  phone         String?
  location      String?
  instagramHandle String?
  tiktokHandle  String?
  about         String
  videoUrls     String[]
  canCommit     Boolean           @default(false)
  status        ApplicationStatus @default(PENDING)
  reviewNotes   String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("creator_applications")
}

// ─── VIRAL NOTIFICATIONS ────────────────────────────────────

enum ViralNotificationChannel {
  EMAIL
  SMS
}

model ViralNotification {
  id         String                   @id @default(cuid())
  postId     String
  creatorId  String
  creator    Creator                  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  channel    ViralNotificationChannel
  sentAt     DateTime                 @default(now())
  status     String                   @default("SENT")
  errorMsg   String?

  @@unique([postId, channel])
  @@index([creatorId])
  @@map("viral_notifications")
}

// ─── CREATOR ATTRIBUTION (PostHog sync) ─────────────────────

model CreatorAttribution {
  id           String   @id @default(cuid())
  creatorId    String
  creator      Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  date         DateTime @db.Date
  signupCount  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([creatorId, date])
  @@index([creatorId])
  @@map("creator_attributions")
}

// ─── CREATOR EARNINGS (for 1099) ────────────────────────────

model CreatorEarning {
  id          String   @id @default(cuid())
  creatorId   String
  creator     Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  amount      Decimal  @db.Decimal(10, 2)
  description String?
  earnedAt    DateTime
  createdAt   DateTime @default(now())

  @@index([creatorId])
  @@map("creator_earnings")
}
